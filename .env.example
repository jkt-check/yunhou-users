# Yunhou Users — environment variable template
# Copy to .env on the host and fill in real values. NEVER commit .env.

PORT=8080

# Database connection. Use sslmode=require (or verify-full) in production;
# sslmode=disable sends the password in cleartext and is for local dev only.
DATABASE_URL=postgres://yunhou:CHANGE_ME@host.docker.internal:5432/yunhou_users?sslmode=disable

# OAuth state HMAC secret (REQUIRED) — signs the state parameter on the
# GitHub OAuth redirect flow. Multi-instance deployments must share the
# same value. Must be at least 32 characters; the server rejects startup
# with a shorter value. Generate with:
#     openssl rand -hex 32
# Even apps that don't enable GitHub login still need this set to a
# sufficiently long value — Validate() (internal/config/config.go:127)
# enforces the minimum length unconditionally.
OAUTH_STATE_SECRET=

# OAuth provider credentials. Yunhou loads these into the Config struct on
# startup, but they are NOT used by the running redirect flow — the
# /auth/github/* handler reads each app's GitHub OAuth App credentials from
# apps.config.oauth_providers.github in the DB instead. Safe to leave blank.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# RSA keys are bind-mounted at /keys inside the container
RSA_PRIVATE_KEY_PATH=/keys/private.pem
RSA_PUBLIC_KEY_PATH=/keys/public.pem

# JWT TTLs
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Order expiry & sweeper (payment subsystem)
ORDER_EXPIRY_DURATION=30m
SWEEPER_INTERVAL=1m

# Channel webhook secrets (leave blank to disable a channel — its webhooks
# will return 404. Set all three to enable Stripe + WeChat + Alipay.)
STRIPE_WEBHOOK_SECRET=
WECHAT_PAY_API_V3_KEY=
ALIPAY_PUBLIC_KEY_PATH=

# PayPal (sandbox + live simultaneously loaded; PAYPAL_ENV selects which is active.
# Leave both webhook IDs blank to disable PayPal webhooks entirely (returns 404).)
PAYPAL_ENV=live
PAYPAL_WEBHOOK_ID_SANDBOX=
PAYPAL_WEBHOOK_ID_LIVE=
PAYPAL_API_BASE_SANDBOX=https://api-m.sandbox.paypal.com
PAYPAL_API_BASE_LIVE=https://api-m.paypal.com

