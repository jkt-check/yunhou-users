# Yunhou Users — environment variable template
# Copy to .env on the host and fill in real values. NEVER commit .env.

PORT=8080

# Database connection. sslmode=require keeps the password off the wire for
# any remote DB host. For a same-host/compose DB you may switch to
# sslmode=disable — local dev only, never for a remote host.
DATABASE_URL=postgres://yunhou:CHANGE_ME@host.docker.internal:5432/yunhou_users?sslmode=require

# OAuth state HMAC secret (REQUIRED) — signs the state parameter on the
# GitHub + WeChat OAuth redirect flows (provider-agnostic binding of
# (app_id, callback_index)). Multi-instance deployments must share the
# same value. Must be at least 32 characters; the server rejects startup
# with a shorter value. Generate with:
#     openssl rand -hex 32
# Even apps that don't enable OAuth login still need this set to a
# sufficiently long value — Validate() (internal/config/config.go:216)
# enforces the minimum length unconditionally.
OAUTH_STATE_SECRET=

# OAuth provider credentials. Yunhou loads these into the Config struct on
# startup, but they are NOT used by the running redirect flow — the
# /auth/github/* handler reads each app's GitHub OAuth App credentials from
# apps.config.oauth_providers.github in the DB instead. Safe to leave blank.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# RSA keys are bind-mounted at /keys inside the container
RSA_PRIVATE_KEY_PATH=/keys/private.pem
RSA_PUBLIC_KEY_PATH=/keys/public.pem

# JWT TTLs
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Order expiry & sweeper (payment subsystem)
ORDER_EXPIRY_DURATION=30m
SWEEPER_INTERVAL=1m

# Channel webhook secrets (leave blank to disable a channel — its webhooks
# will return 404. Set all three to enable Stripe + WeChat + Alipay.)
STRIPE_WEBHOOK_SECRET=
# WeChat Pay v3: the six fields below are an all-or-none tuple in real mode
# (all six set, or all empty = disabled). WECHAT_PAY_MOCK=1 relaxes this for
# dev/e2e. See README for the full contract.
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
WECHAT_PAY_MCH_CERT_PATH=
ALIPAY_PUBLIC_KEY_PATH=

# OAuth / payment mocks (dev + e2e only — NEVER enable in production)
WECHAT_OAUTH_MOCK=
WECHAT_PAY_MOCK=
# Dev-only gate for POST /test/login?plan_id=<plan-id> (mints JWTs without
# OAuth). `1` enables; anything else (or unset) = endpoint returns 404.
PAYPAL_L3_E2E_MODE=

# Optional (plan_id → amount-yuan) price override for dev/staging payment
# flows, e.g. {"monthly":0.01,"yearly":0.1}. Empty by default.
PLAN_AMOUNT_OVERRIDE_JSON=

# PayPal (sandbox + live simultaneously loaded; PAYPAL_ENV selects which is active.
# Leave both webhook IDs blank to disable PayPal webhooks entirely (returns 404).
# PAYPAL_ENV defaults to empty = disabled; set to sandbox or live only when you
# actually enable PayPal on this deployment.)
PAYPAL_ENV=
PAYPAL_WEBHOOK_ID_SANDBOX=
PAYPAL_WEBHOOK_ID_LIVE=
PAYPAL_API_BASE_SANDBOX=https://api-m.sandbox.paypal.com
PAYPAL_API_BASE_LIVE=https://api-m.paypal.com

# Chat proxy (POST /chat → DeepSeek chat.completions, SSE). Server-side key:
# consumer apps never see it. Leave DEEPSEEK_API_KEY blank to disable the
# endpoint (returns 404). This is the fallback used when LLM_PROVIDERS_JSON
# is unset (see below).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Multi-model chat catalog (takes precedence over DEEPSEEK_* when set).
# JSON object: providers (protocol openai|anthropic, base_url, api_keys[],
# optional headers{}) + models (logical id → provider, upstream_model,
# display_name, prices in CNY per 1M tokens, optional max_tokens).
# LLM_PROVIDERS_JSON={"default_model":"deepseek-flash","providers":{"deepseek":{"protocol":"openai","base_url":"https://api.deepseek.com","api_keys":["sk-..."]},"kimi":{"protocol":"anthropic","base_url":"https://api.kimi.com/coding","api_keys":["sk-kimi-..."]}},"models":{"deepseek-flash":{"provider":"deepseek","upstream_model":"deepseek-chat","display_name":"DeepSeek Flash","input_price_per_mtok":2,"output_price_per_mtok":8},"kimi-k3":{"provider":"kimi","upstream_model":"kimi-k3-latest","display_name":"Kimi K3","max_tokens":16384}}}
LLM_PROVIDERS_JSON=
# Chat access audit log: one JSON line per request (user_id, session_id,
# input messages, output text, status, duration). Empty = disabled.
CHAT_LOG_PATH=


# Inference module (Kaya Coding Plan Task 4) — upstream credential vault.
# AEAD key material, injected from the deployment secret store ONLY (never
# commit real values). Format: version:64hexchars pairs, comma-separated;
# the highest version is the current encryption key, earlier versions stay
# for decrypting old ciphertext. Generate a key with: openssl rand -hex 32
# Empty = credential management endpoints fail closed until configured.
INFERENCE_CREDENTIAL_KEYS=
# Upstream egress allowlist (SSRF policy, 设计 §5): comma-separated CIDRs
# and/or exact hostnames permitted as NON-globally-routable upstream
# deployment targets (self-hosted intranet models). Empty = only public
# targets; loopback/link-local/metadata/private addresses are always
# rejected unless matched here.
INFERENCE_UPSTREAM_ALLOWLIST=
# Per-billing-account requests-per-minute bucket on /v1/* (Task 5;
# per-Key rpm_limit applies on top when set on the key). Process-local
# sliding window — cross-instance coordination is Task 7. 0 disables the
# account-level bucket.
INFERENCE_ACCOUNT_RPM=120
# /chat 迁移开关（Kaya Coding Plan Task 8）。默认关闭 = 旧 DeepSeek 直通
# 行为不变；设为 1 时 POST /chat 与 GET /chat/models 由 inference 网关
# facade 承接（JWT → principal → 权益 → 配额预占 → 路由 → 结算），此时
# 必须配置 KAYA_CHAT_MODEL（客户端不带 model 时使用的公开模型 id）。
INFERENCE_KAYA_CHAT_GATEWAY=
KAYA_CHAT_MODEL=

# Inference settlement recovery worker (Kaya Coding Plan Task 9) — crash
# recovery for stranded in-flight requests: conservative-estimate settlement
# (= reserved hold, correctable), reconciliation queue, deadline escalation,
# ledger/window reconciliation. Never zeroes unknown usage, never releases
# by TTL alone.
# INFERENCE_RECOVERY_INTERVAL: pass interval (default 30s).
INFERENCE_RECOVERY_INTERVAL=
# INFERENCE_RECOVERY_BATCH: per-pass scan/job batch cap (default 100).
INFERENCE_RECOVERY_BATCH=
# INFERENCE_RECOVERY_GRACE: a request untouched longer than this is treated
# as a crash candidate (default 15m). MUST exceed the worst live request
# phase — deployment RequestTimeout (default 10m), nginx SSE relay 700s,
# settlement 15s; Validate rejects values below 12m. Raise it if you raise
# deployment request timeouts beyond that.
INFERENCE_RECOVERY_GRACE=
# INFERENCE_RECONCILIATION_DEADLINE: evidence window for reconciliation
# jobs before escalation (default 24h; escalation pages a human, it never
# releases holds or zeroes charges).
INFERENCE_RECONCILIATION_DEADLINE=
# INFERENCE_ENTITLEMENT_SYNC_INTERVAL: outbox consumer pass interval for
# payment → entitlement grants (default 2s; grants land within seconds of
# the payment committing).
INFERENCE_ENTITLEMENT_SYNC_INTERVAL=
# INFERENCE_ENTITLEMENT_SYNC_BATCH: per-pass message cap (default 100).
INFERENCE_ENTITLEMENT_SYNC_BATCH=

# Inference upstream OAuth connectors (Kaya Coding Plan Task 12) — 独立于
# 社交登录（GitHub/WeChat OAuth）的上游授权接入，互不复用配置。
# INFERENCE_OAUTH_CONNECTORS_JSON: JSON array of vendor specs, e.g.
#   [{"key":"vendor-x","authorize_url":"https://vendor.example/authorize",
#     "token_url":"https://vendor.example/token","revoke_url":"...",
#     "models_url":"...","quota_url":"...","client_id":"...",
#     "client_secret":"...","scopes":["..."],"redirect_url":"https://ops.example/admin/oauth/callback"}]
# client_secret 是部署秘密（只经此 env 注入，不入库不记日志）。空 = OAuth
# 授权端点拒绝一切 connector key（fail closed）。
INFERENCE_OAUTH_CONNECTORS_JSON=
# Credential-refresh worker: proactive OAuth rotation under a cross-instance
# advisory lock + generation CAS. INTERVAL pass interval (default 60s),
# BATCH per-pass cap (default 50), SKEW rotate this early before access-token
# expiry (default 5m).
INFERENCE_CREDENTIAL_REFRESH_INTERVAL=
INFERENCE_CREDENTIAL_REFRESH_BATCH=
INFERENCE_CREDENTIAL_REFRESH_SKEW=
# Upstream-health worker: account probes + upstream quota observation
# (observed_at/source/reset_at; 不可得保持未知). INTERVAL pass interval
# (default 60s), BATCH per-pass cap (default 100), COOLDOWN failed accounts
# stay unschedulable this long before re-probe (default 5m).
INFERENCE_UPSTREAM_HEALTH_INTERVAL=
INFERENCE_UPSTREAM_HEALTH_BATCH=
INFERENCE_UPSTREAM_HEALTH_COOLDOWN=

# ---- Relay(kaya 远程控制 WS 中继)----
# HMAC ticket 签名 secret;留空 = relay 禁用(不注册 /relay/* 路由)
RELAY_TICKET_SECRET=
# 轮换期的上一个 secret(校验时与当前 secret 一并接受)
RELAY_TICKET_SECRET_PREVIOUS=
# 浏览器 Origin 白名单,逗号分隔;空 = 拒绝一切带 Origin 头的 WS 握手
RELAY_ALLOWED_ORIGINS=https://www.yunhouai.com,https://www.yunhou.ai
# 可选:覆盖 /relay/ticket 返回的 ws_url;空 = 按请求 Host 推导。
# 生产建议指向不过 CDN 的直连域名(如 wss://api.yunhouai.com/relay/ws)——
# 经 CDN 的 vhost 会被剥 Upgrade 头,WS 握手 426。
RELAY_WS_URL=
# metrics env label
APP_ENV=prod
