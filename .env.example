# Yunhou Users — environment variable template
# Copy to .env on the host and fill in real values. NEVER commit .env.

PORT=8080

# Database connection. Use sslmode=require (or verify-full) in production;
# sslmode=disable sends the password in cleartext and is for local dev only.
DATABASE_URL=postgres://yunhou:CHANGE_ME@host.docker.internal:5432/yunhou_users?sslmode=disable

# OAuth state HMAC secret (REQUIRED) — signs the state parameter on the
# GitHub + WeChat OAuth redirect flows (provider-agnostic binding of
# (app_id, callback_index)). Multi-instance deployments must share the
# same value. Must be at least 32 characters; the server rejects startup
# with a shorter value. Generate with:
#     openssl rand -hex 32
# Even apps that don't enable OAuth login still need this set to a
# sufficiently long value — Validate() (internal/config/config.go:216)
# enforces the minimum length unconditionally.
OAUTH_STATE_SECRET=

# OAuth provider credentials. Yunhou loads these into the Config struct on
# startup, but they are NOT used by the running redirect flow — the
# /auth/github/* handler reads each app's GitHub OAuth App credentials from
# apps.config.oauth_providers.github in the DB instead. Safe to leave blank.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# RSA keys are bind-mounted at /keys inside the container
RSA_PRIVATE_KEY_PATH=/keys/private.pem
RSA_PUBLIC_KEY_PATH=/keys/public.pem

# JWT TTLs
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Order expiry & sweeper (payment subsystem)
ORDER_EXPIRY_DURATION=30m
SWEEPER_INTERVAL=1m

# Channel webhook secrets (leave blank to disable a channel — its webhooks
# will return 404. Set all three to enable Stripe + WeChat + Alipay.)
STRIPE_WEBHOOK_SECRET=
# WeChat Pay v3: the six fields below are an all-or-none tuple in real mode
# (all six set, or all empty = disabled). WECHAT_PAY_MOCK=1 relaxes this for
# dev/e2e. See README for the full contract.
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
WECHAT_PAY_MCH_CERT_PATH=
ALIPAY_PUBLIC_KEY_PATH=

# OAuth / payment mocks (dev + e2e only — NEVER enable in production)
WECHAT_OAUTH_MOCK=
WECHAT_PAY_MOCK=
# Dev-only gate for POST /test/login?plan_id=<plan-id> (mints JWTs without
# OAuth). `1` enables; anything else (or unset) = endpoint returns 404.
PAYPAL_L3_E2E_MODE=

# Optional (plan_id → amount-yuan) price override for dev/staging payment
# flows, e.g. {"monthly":0.01,"yearly":0.1}. Empty by default.
PLAN_AMOUNT_OVERRIDE_JSON=

# PayPal (sandbox + live simultaneously loaded; PAYPAL_ENV selects which is active.
# Leave both webhook IDs blank to disable PayPal webhooks entirely (returns 404).
# PAYPAL_ENV defaults to empty = disabled; set to sandbox or live only when you
# actually enable PayPal on this deployment.)
PAYPAL_ENV=
PAYPAL_WEBHOOK_ID_SANDBOX=
PAYPAL_WEBHOOK_ID_LIVE=
PAYPAL_API_BASE_SANDBOX=https://api-m.sandbox.paypal.com
PAYPAL_API_BASE_LIVE=https://api-m.paypal.com

# Chat proxy (POST /chat → DeepSeek chat.completions, SSE). Server-side key:
# consumer apps never see it. Leave DEEPSEEK_API_KEY blank to disable the
# endpoint (returns 404).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Chat access audit log: one JSON line per request (user_id, session_id,
# input messages, output text, status, duration). Empty = disabled.
CHAT_LOG_PATH=

