+		h.ListUserSubscriptions(c)
+	})
+
+	req := httptest.NewRequest(http.MethodGet, "/user/subscriptions", nil)
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	if w.Code != http.StatusOK {
+		t.Fatalf("status=%d", w.Code)
