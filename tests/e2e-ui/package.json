{
  "name": "yunhou-users-paypal-e2e-ui",
  "version": "0.1.0",
  "private": true,
  "description": "L3 Playwright + PayPal sandbox UI integration tests for yunhou-users",
  "scripts": {
    "smoke": "playwright test --grep @smoke",
    "paypal:happy": "playwright test --grep @happy",
    "paypal:decline": "playwright test --grep @decline",
    "paypal:refund": "playwright test --grep @refund",
    "paypal:renewal": "playwright test --grep @renewal",
    "all": "playwright test",
    "report": "playwright show-report",
    "trace": "playwright test --trace on",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.45.0",
    "@types/node": "20.11.30",
    "@types/pg": "8.11.6",
    "pg": "8.13.0",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
